config_version=5

[application]

config/name="Last Signal — Room 1 (Medical Wing)"
config/description="Top-down 2D pixel art adventure/survival/stealth/puzzle. Trapped in abandoned research station K-17: activate three communication towers and send an emergency transmission."
run/main_scene="res://scenes/levels/rooms/medical_wing/play_medical_wing.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/sprites/characters/player.png"

[gui]

theme/default_font="res://assets/fonts/Vazirmatn-Regular.ttf"
theme/default_font_size=16

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

