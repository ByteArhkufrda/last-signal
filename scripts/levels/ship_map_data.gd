const FLOOR_IS_HOLE := [false, true, true, true, true]


static func polygons(holes: bool) -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	for i in FLOOR_POLYGONS.size():
		if FLOOR_IS_HOLE[i] != holes:
			continue
		var flat: Array = FLOOR_POLYGONS[i]
		var pts := PackedVector2Array()
		for j in range(0, flat.size(), 2):
			pts.append(Vector2(flat[j], flat[j + 1]) * MAP_SCALE)
		out.append(pts)
	return out
